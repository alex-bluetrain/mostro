# Required — the boot fails without these
OPENROUTER_API_KEY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
MONGODB_URI=
MONGODB_DB_NAME=

# Optional vars must be absent, NOT empty: an empty value fails zod validation
# and aborts the boot. Uncomment only the ones you fill in.

# Admin seed — without ADMIN_EMAIL nobody is authorized (see docs/identity.md)
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_TELEGRAM_ID=

# Ngrok tunnel for Telegram webhooks and external provider callbacks
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=
# Studio's default "instance URL" otherwise stays hardcoded to localhost:4111,
# which breaks Studio when opened from the ngrok domain. This makes it use
# window.location.origin instead, so it works from any origin (LAN, ngrok, etc).
MASTRA_AUTO_DETECT_URL=true

# Google SSO for the web (redirect: https://<NGROK_DOMAIN>/api/auth/sso/callback)
# These belong to the SSO's own Google Cloud project — NOT the mailer's (see below).
# generate cookie password with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GOOGLE_SSO_CLIENT_ID=
# GOOGLE_SSO_CLIENT_SECRET=
# GOOGLE_SSO_REDIRECT_URI=
# GOOGLE_SSO_COOKIE_PASSWORD=

# Gmail (outbound email) — required, the boot fails without these.
# A SEPARATE Google Cloud project from the SSO above: the mailer needs the sensitive
# gmail.send scope and its app must be published, which would otherwise change the
# consent screen your users see when logging in. Get the refresh token with:
# pnpm run gmail:auth
GMAIL_MAILER_CLIENT_ID=
GMAIL_MAILER_CLIENT_SECRET=
GMAIL_MAILER_REFRESH_TOKEN=
GMAIL_MAILER_SENDER=
DIAPERS_EMAIL_TO=
MEDS_EMAIL_TO=
REFUNDS_EMAIL_TO=
