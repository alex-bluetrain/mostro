{
  "name": "mostro",
  "version": "1.0.1",
  "description": "A multi-agent Telegram bot for managing recurring family orders — diapers, medications, and refunds — built with Mastra.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Alex Verstraeten <averstraeten@gmail.com>",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gmail:auth": "node --env-file=.env scripts/gmail-authorize.mjs",
    "seed:classifier": "node --env-file=.env --import tsx scripts/seed-classifier.ts"
  },
  "dependencies": {
    "@chat-adapter/telegram": "^4.32.0",
    "@googleapis/gmail": "^17.0.0",
    "@mastra/auth-google": "^0.1.0",
    "@mastra/core": "^1.48.0",
    "@mastra/duckdb": "^1.5.0",
    "@mastra/evals": "^1.5.1",
    "@mastra/libsql": "^1.14.3",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.22.0",
    "@mastra/mongodb": "^1.11.1",
    "@mastra/observability": "^1.15.2",
    "@ngrok/ngrok": "^1.7.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.2.0",
    "email-reply-parser": "^2.3.9",
    "mongodb": "^7.5.0",
    "mongoose": "^8.24.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/email-reply-parser": "^1.4.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.0",
    "mailparser": "^3.7.4",
    "mastra": "^1.17.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
