# syntax=docker/dockerfile:1
# Variante local del Dockerfile: sin Infisical ni GCP. Los secretos se inyectan
# por env (env_file en el compose). Arranca node directo, no `infisical run`.

# ---- build ----
FROM node:22-slim AS builder
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

# --studio agrega el frontend de Studio al output autocontenido.
RUN pnpm build --studio

# ---- runtime ----
FROM node:22-slim AS runtime
WORKDIR /app

COPY --from=builder --chown=node:node /app/.mastra/output ./

RUN mkdir -p /data && chown node:node /data
ENV DUCKDB_PATH=/data/mastra.duckdb
ENV NODE_ENV=production
ENV PORT=4111
ENV MASTRA_STUDIO_PATH=/app/studio
EXPOSE 4111

USER node

CMD ["node", "index.mjs"]
